# ============================================================
# 环境变量配置
# 使用方法：cp .env.example .env，然后修改下方带 CHANGEME 的值
# ⚠️ 严禁将 .env 提交到版本控制，严禁在生产环境使用示例占位值
# ============================================================

# ---- MySQL ----
MYSQL_ROOT_PASSWORD=CHANGEME_mysql_root_password
MYSQL_DATABASE=product_mgmt

# ---- Backend ----
DB_HOST=db
DB_PORT=3306
DB_USER=root
DB_PASSWORD=CHANGEME_mysql_root_password
DB_NAME=product_mgmt
# ⚠️ 生产环境请替换为随机字符串（至少 32 位），例如: openssl rand -hex 32
JWT_SECRET=CHANGEME_jwt_secret_replace_with_random_string
JWT_EXPIRE_MINUTES=480
UPLOAD_DIR=/app/uploads

# ---- Redis（可选，配置后限流将使用 Redis 共享存储，适用于多实例部署）----
# 留空则使用内存限流（单实例）
REDIS_URL=
# 生产示例: REDIS_URL=redis://redis:6379/0

# ---- CORS（逗号分隔，仅列出可信域名；* 仅限开发环境）----
# 生产示例: CORS_ORIGINS=https://admin.example.com,https://www.example.com
CORS_ORIGINS=*
